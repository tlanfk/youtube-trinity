{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "version": "1.0.7",
    "description": "__MSG_extDescription__",
    "default_locale": "en",
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "action": {
        "default_icon": "icon.png",
        "default_title": "__MSG_popupActionTitle__",
        "default_popup": "popup.html"
    },
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://www.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ]
        }
    ]
}
