{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "version": "1.0.7",
    "description": "__MSG_extDescription__",
    "default_locale": "en",
    "browser_specific_settings": {
        "gecko": {
            "id": "youtube-trinity@doolli.local",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            },
            "strict_min_version": "142.0"
        }
    },
    "icons": {
        "16": "icon-16.png",
        "48": "icon-48.png",
        "128": "icon.png"
    },
    "action": {
        "default_icon": "icon.png",
        "default_title": "__MSG_popupActionTitle__",
        "default_popup": "popup.html"
    },
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://www.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ]
        }
    ]
}
